#!/usr/bin/env bash
# Manage the RVC servers (WebUI, live conversion) as background services.
#
#   rvc-svc up      [service...]   start (default: all)
#   rvc-svc down    [service...]   stop
#   rvc-svc restart [service...]   stop, then start
#   rvc-svc status                 show state of every service
#   rvc-svc logs    <service> [-f] show (or follow) a service log
#
# PID files: ${XDG_RUNTIME_HOME:-~/.local/run}/rvc/<service>.pid
# Logs:      ${XDG_STATE_HOME:-~/.local/state}/rvc/<service>.log
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
RUN_DIR=${RVC_RUN_DIR:-$HOME/.local/run/rvc}
LOG_DIR=${RVC_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/rvc}
START_TIMEOUT=${RVC_START_TIMEOUT:-180}
STOP_TIMEOUT=${RVC_STOP_TIMEOUT:-20}

ALL=(webui live)
declare -A TASK=([webui]=webui [live]=live)
declare -A PORT=([webui]=7865 [live]=7867)
declare -A HEALTH=([webui]=/ [live]=/live/)
# Pattern that identifies the service's own process (for orphan cleanup).
declare -A MATCH=([webui]='python webui.py' [live]='python -m tools.live.server')

mkdir -p "$RUN_DIR" "$LOG_DIR"

say()  { printf '%s\n' "$*"; }
err()  { printf '%s\n' "$*" >&2; }
pidf() { echo "$RUN_DIR/$1.pid"; }
logf() { echo "$LOG_DIR/$1.log"; }

check_service() {
  [[ -n "${TASK[$1]:-}" ]] || { err "알 수 없는 서비스: $1 (가능: ${ALL[*]})"; exit 2; }
}

# PID from the pid file if that process is still ours, else empty.
managed_pid() {
  local f; f=$(pidf "$1")
  [[ -f $f ]] || return 0
  local pid; pid=$(<"$f")
  if [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null \
     && [[ $(ps -o pgid= -p "$pid" | tr -d ' ') == "$pid" ]]; then
    echo "$pid"
  else
    rm -f "$f"   # stale
  fi
}

# PID listening on the service port, if any.
port_pid() {
  ss -ltnpH "sport = :${PORT[$1]}" 2>/dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2
}

# True when the port can be bound the way the servers bind it (SO_REUSEADDR:
# TIME_WAIT leftovers are fine, a live listener is not). Guards against a
# process that is still shutting down.
port_bindable() {
  python3 -c 'import socket,sys
s=socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
try: s.bind(("0.0.0.0",int(sys.argv[1])))
except OSError: sys.exit(1)' "${PORT[$1]}"
}

wait_port_free() {
  local s=$1 t0=$SECONDS said=0
  until port_bindable "$s"; do
    if ((!said)); then say "  포트 ${PORT[$s]} 해제 대기 중…"; said=1; fi
    if ((SECONDS - t0 > 30)); then err "✗ $s: 포트 ${PORT[$s]}이(가) 30초 넘게 풀리지 않습니다."; return 1; fi
    sleep 1
  done
}

health() {
  curl -s -o /dev/null -m 3 -w '%{http_code}' "http://127.0.0.1:${PORT[$1]}${HEALTH[$1]}" 2>/dev/null || true
}

stop_group() {  # $1=pgid
  local pg=$1
  kill -TERM -- "-$pg" 2>/dev/null || return 0
  for ((i = 0; i < STOP_TIMEOUT * 2; i++)); do
    kill -0 -- "-$pg" 2>/dev/null || return 0
    sleep 0.5
  done
  err "  응답이 없어 강제 종료합니다 (pgid $pg)"
  kill -KILL -- "-$pg" 2>/dev/null || true
}

down_one() {
  local s=$1 pid
  pid=$(managed_pid "$s")
  if [[ -n $pid ]]; then
    say "■ $s 중지 (pid $pid)"
    stop_group "$pid"
    rm -f "$(pidf "$s")"
  fi
  # A server started outside this script (no pid file) still holding the port.
  local other; other=$(port_pid "$s")
  if [[ -n $other ]]; then
    if ps -o args= -p "$other" | grep -qF "${MATCH[$s]}"; then
      local pg; pg=$(ps -o pgid= -p "$other" | tr -d ' ')
      say "■ $s 중지 (pid 파일 없이 실행 중이던 프로세스 $other)"
      stop_group "$pg"
    else
      err "  포트 ${PORT[$s]}을(를) 다른 프로그램이 쓰고 있습니다: $(ps -o pid=,args= -p "$other")"
      return 1
    fi
  elif [[ -z $pid ]]; then
    say "· $s 이미 꺼져 있음"
  fi
}

up_one() {
  local s=$1 pid
  pid=$(managed_pid "$s")
  if [[ -n $pid ]]; then
    say "· $s 이미 실행 중 (pid $pid)"
    return 0
  fi
  local other; other=$(port_pid "$s")
  if [[ -n $other ]]; then
    err "✗ $s: 포트 ${PORT[$s]}이(가) 이미 사용 중입니다: $(ps -o pid=,args= -p "$other")"
    err "  'just down $s'로 정리한 뒤 다시 시도하세요."
    return 1
  fi
  wait_port_free "$s" || return 1
  local log; log=$(logf "$s")
  printf '\n===== %s start %s =====\n' "$s" "$(date '+%F %T')" >>"$log"
  local mark; mark=$(wc -l <"$log")
  say "▶ $s 시작 중… (로그: $log)"
  cd "$ROOT"
  # setsid: own process group, so 'down' stops mise and its python child together.
  setsid mise run "${TASK[$s]}" >>"$log" 2>&1 </dev/null &
  pid=$!
  echo "$pid" >"$(pidf "$s")"
  local t0=$SECONDS code
  while ((SECONDS - t0 < START_TIMEOUT)); do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$(pidf "$s")"
      err "✗ $s 시작 실패. 로그 마지막 부분:"
      tail -n 25 "$log" | sed 's/^/  │ /' >&2
      return 1
    fi
    if tail -n +"$mark" "$log" | grep -q 'is occupied; trying port'; then
      err "✗ $s: 포트 ${PORT[$s]} 대신 다른 포트로 뜨려고 해서 중지했습니다. 다시 시도하세요."
      stop_group "$pid"; rm -f "$(pidf "$s")"
      return 1
    fi
    code=$(health "$s")
    if [[ $code == 200 ]]; then
      say "✓ $s 준비됨 — http://127.0.0.1:${PORT[$s]}  (pid $pid, $((SECONDS - t0))초)"
      return 0
    fi
    sleep 1
  done
  err "✗ $s: ${START_TIMEOUT}초 안에 응답이 없습니다. 'just logs $s'로 확인하세요 (프로세스는 계속 실행 중)."
  return 1
}

status() {
  printf '%-6s %-8s %-8s %-6s %-6s %-10s %s\n' 서비스 상태 PID 포트 HTTP 실행시간 로그
  local s pid state code up
  for s in "${ALL[@]}"; do
    pid=$(managed_pid "$s"); code=$(health "$s"); up=-
    if [[ -n $pid ]]; then
      state=$([[ $code == 200 ]] && echo 실행중 || echo 시작중?)
      up=$(ps -o etime= -p "$pid" | tr -d ' ')
    elif [[ -n $(port_pid "$s") ]]; then
      state=미관리; pid=$(port_pid "$s")
    else
      state=꺼짐; pid=-
    fi
    printf '%-6s %-8s %-8s %-6s %-6s %-10s %s\n' "$s" "$state" "$pid" "${PORT[$s]}" "${code:-000}" "$up" "$(logf "$s")"
  done
}

services() {  # validated list from args, default all
  if (($# == 0)); then printf '%s\n' "${ALL[@]}"; return; fi
  local s; for s in "$@"; do check_service "$s"; echo "$s"; done
}

cmd=${1:-status}; shift || true
rc=0
case $cmd in
  up)      for s in $(services "$@"); do up_one "$s" || rc=1; done ;;
  down)    for s in $(services "$@"); do down_one "$s" || rc=1; done ;;
  restart) for s in $(services "$@"); do down_one "$s" || rc=1; up_one "$s" || rc=1; done ;;
  status)  status ;;
  logs)
    s=${1:-}; [[ -n $s ]] || { err "사용법: rvc-svc logs <${ALL[*]// /|}> [-f]"; exit 2; }
    check_service "$s"; shift
    if [[ ${1:-} == -f ]]; then exec tail -n 50 -F "$(logf "$s")"; else exec tail -n 80 "$(logf "$s")"; fi ;;
  *) err "사용법: rvc-svc {up|down|restart|status|logs} [service...]"; exit 2 ;;
esac
exit $rc
